[user]
	name = Vaishnav Sabari Girish
	email = vaishnav.sabari.girish@gmail.com
	signingkey = 71922ABFB77026CC

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "smtp://smtp.gmail.com:587"]
	helper = libsecret

[pull]
	rebase = false

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[gpg]
	program = gpg

[sendemail]
	smtpServer = smtp.gmail.com
	smtpServerPort = 587
	smtpEncryption = tls
	smtpUser = vaishnav.sabari.girish@gmail.com
	from = vaishnav.sabari.girish@gmail.com

[http]
	sslBackend = openssl

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

[pager]
	diff = diffnav

[alias]
	release = "!git cliff --bump minor -o CHANGELOG.md && git add CHANGELOG.md && git commit -m 'chore(release): update changelog'"
