[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[pull]
	rebase = false

[gpg]
	program = gpg

[sendemail]
	smtpServer = smtp.gmail.com
	smtpServerPort = 587
	smtpEncryption = tls

[credential "smtp://smtp.gmail.com:587"]
	helper = libsecret

[http]
	sslBackend = openssl
	version = HTTP/1.1

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true

# Note: this overrides core.pager for `git diff` only
[pager]
	diff = diffnav

[alias]
	release = "!git cliff --bump minor -o CHANGELOG.md && git add CHANGELOG.md && git commit -m 'chore(release): update changelog'"
