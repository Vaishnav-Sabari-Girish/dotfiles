UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"9eTeYkUfqns","title":"I Asked Prot How Good Cyprus Olive Oil Really Is","published":1791820861000,"viewCount":143,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"vs81-Bc9gvI","title":"I Finally Admit the Mouse Is Better Sometimes","published":1791802866000,"viewCount":297,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"TcN72jplwis","title":"The AI Users Who Learn Fastest Will Pull Ahead","published":1791770456000,"viewCount":469,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"G10pv6DwZwA","title":"Why I'm Worried Omarchy Could Be Abandoned","published":1791752462000,"viewCount":501,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"p0lAU-7y998","title":"Why I Finally Switched From GPT to Claude","published":1791734453000,"viewCount":340,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"-k9Jq_2mmaw","title":"I Couldn't Find Omarchy's Super Key on My Mac","published":1791716461000,"viewCount":331,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"TvxUazlN3AA","title":"Why AI Became My Solo Creator Assistant","published":1791684062000,"viewCount":322,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"ZA1E66nHHTA","title":"Home-Row Mods - My 85 WPM Monkeytype Stress Test","published":1791666062000,"viewCount":469,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"IE_mHX4Wl_k","title":"Prot Explains Why Public Life Is Becoming Unaffordable","published":1791648066000,"viewCount":186,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"-LaKtn5M0yk","title":"Why I Keep Coding-Agent Screenshots Local","published":1791630072000,"viewCount":464,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"7XHhFdMaYMM","title":"The Daily Work That AI Is Best Positioned to Automate","published":1791597652000,"viewCount":450,"type":"video","lengthSeconds":"0:00","isRSS":true},{"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","videoId":"Y6ZvNvBMRPY","title":"My Perfect Keyboard Workflow Is Terrible for You","published":1791579653000,"viewCount":272,"type":"video","lengthSeconds":"0:00","isRSS":true}],"shortsTimestamp":{"$$date":1791905440524},"communityPosts":[{"postText":"Yesterday I needed to test TTS during a livestream, so decided to set up an unlisted livestream, was the only person watching it from <a href=\"https://www.youtube.com/channel/UCwdm3PFpDuNtMaqAU6qxVBA\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UCwdm3PFpDuNtMaqAU6qxVBA</a> and decided to give away 5 memberships, so that I would get it. MF didn&apos;t give me shait so still had to pay for it","postId":"UgkxLGFpaBez3fQ1XVo9-XyQFYbX8wfnm7ux","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1790091052135,"voteCount":3,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/NLkUKAO6Ye_7YzKD3MK9gRjsnFNjGrKqmMDgwIn97eV8bGsmxDX-pPQ0V70hsbICr7oLuRWnFzFW=s640-c-fcrop64=1,00000000ffffffff-nd-v1-rwa","width":640,"height":640}]},"commentCount":null,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"Scheduled changed to 1 hour earlier. Will see you folks in a few hours.","postId":"UgkxqHMn55rAwR3ULQ_hCjCEHwCPdjSMXylD","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1789313452135,"voteCount":1,"postContent":null,"commentCount":null,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"This is a livestream episode that happens with Discord members every once in a while. There&apos;s no frequency or exact cadence, it just happens on random dates. You can share your workflow, talk about your YouTube channel, Neovim, Emacs, BScode, promote yourself. Whatever you want as long as it&apos;s tech related. \n\nMore information can be found here:\n<a href=\"https://linkarzu.com/posts/youtube/youtube-memberships/#member\" target=\"_blank\" rel=\"noopener noreferrer\">linkarzu.com/posts/youtube/youtube-memberships/#member</a>\n\nIt used to be called FurryConf, but people thought the guests were actual furries and didn&apos;t seem to click with the theme. So there&apos;s a rebrand going on, to appeal the masses.","postId":"Ugkxw49IJuekw-zKKDDrcjezP68vjgIqWnfZ","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1786721452135,"voteCount":13,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/KmX8rLsl9F7YFnGOHPKZudR5IwbrrIy9TVAP3bvvgbSc5ZMBii6QjyqqSghG4XKaiUC4ER6lUR0e-Q=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}]},"commentCount":1,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"Yesterday, a new member joined as a CEO <a href=\"https://www.youtube.com/channel/UCIF7NlNYrcOK2nTH2GqtGAQ\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UCIF7NlNYrcOK2nTH2GqtGAQ</a> \n\nThis means we&apos;ll be seeing him 2 times a month in the &quot;Linkarzu Root Access&quot; podcast. Due to this I also upgraded my podcasting hosting plan, so the episode we have today and all the past ones are available in all podcasting platforms, like Spotify, Apple podcasts, YouTube Music, etc.\n\nAlso, quick shoutout to ma boi Cashmere which joined as an Executive Producer a few days ago. \n\nAppreciate the support to all the members that have recently joined ❤️\n\nSee you later today in the livestream so we get to know Ted (Techieman)","postId":"UgkxZuWPBRtErSl2jkrttZ5nCZCeUNGRtXGu","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1784129452135,"voteCount":17,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/mIOK-0Nr_uO_nnDjmN7ipc8GNsfEju76vhK2NF62w9JVVxH0yOziHh5XbN_kTDtNNAYg16KC9Zle=s640-c-fcrop64=1,00000000ffffffff-nd-v1-rwa","width":640,"height":640}]},"commentCount":2,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"Just today I lost like 30 subscribers...\n\nBut ironically, this is also the time where I’ve received the most support through Ko-fi, YouTube memberships, and even YouTube AdSense revenue.\n\nSo honestly, I think this means I’m doing things right.\n\nMy audience is healing, and I’m really happy about it.\n\nI don’t really understand why people get too concerned when their subscriber count goes down. Sometimes it can be a positive thing. The people who stay are the ones who are really into your stuff, and that matters way more.\n\nTo everyone who watches my content and supports me, I really appreciate it!\n\nBy the way, I think the last $100 I received on Ko-fi came from the macOS screenshot vibe-coded app developer (macshot). Conflict of interest? 😂\n\nDon’t worry, I’ll bitch if something is broken. We need bro&apos;s tokens to replace other paid macOS apps 😂","postId":"UgkxIgwiXPtP532hCCJAK2t9F6cWYAS2NoMK","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1784129452135,"voteCount":36,"postContent":{"type":"multiImage","content":[[{"url":"https://yt3.ggpht.com/-TAkDdgacAowJ0U40-4tvXGdoxlZ4jvqiRw25cp4JRVnBQz6ci174FBqy1ObaLb8BZClaQhR5xWcCw=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}],[{"url":"https://yt3.ggpht.com/l4AkmaxohdsoHsPX4oGLOkGwiFm-UCR0_Glv1qZjMelS9rQeKf9qohPSddPhgHexvAx9AsamXYK2JQ=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}]]},"commentCount":17,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"Are you gonna miss out on being a member just because you&apos;re cheap? You know you want it...\nIt was just a matter of time before the furries found me","postId":"Ugkxk_uxuQ6BdMOKljNiBjct1P1xfu0roc_N","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1784129452135,"voteCount":10,"postContent":{"type":"multiImage","content":[[{"url":"https://yt3.ggpht.com/Fy8E8tAmf3yUJprU0Z_UzR2-3wzkup9D5e3OmY02SnVvcneIraEB2yfWMq-TjZYRlaAxNSRrMaPwQA=s640-c-fcrop64=1,00000000ffffffff-nd-v1-rwa","width":640,"height":640}],[{"url":"https://yt3.ggpht.com/ky1Qlm_CLrKtBzHo_5gsmGxl0ygKkz2bdv134rWdOUNjl3mpWv5IAoWPsqAWwS-_Ym6g7yhdUTBQyD8=s640-c-fcrop64=1,00000000ffffffff-nd-v1-rwa","width":640,"height":640}]]},"commentCount":null,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"I created a new Discord server for YouTube channel members.\n\nI had a Discord server already, with over 400 members, but it became a time sink and honestly a burden instead of a community.\n\nA lot of people there didn’t even watch my videos, and that was not the original intent. My YouTube channel comes first, everything else comes after, so I nuked it.\n\nThis time is different.\n\nThe Discord will be available only for people that have any of my YouTube memberships. I want it to be an actual community, mainly for the people that already hang out in the livestreams, so they can also chat with each other after the livestream ends.\n\nThe membership also includes loyalty badges, my goated emojis, Text To Speech for messages sent in livestreams, and now the members-only Discord.\n\nThe goal is to share ideas, videos, stuff to react to, and just have a place to hang out.\n\nIt will not be a place where I provide support. If you need help with something, join one of my livestreams and ask there. It is faster and simpler for me to answer and show you on my screen than to type everything on Discord.\n\nI also need to filter people out. I don’t want everybody to join again, because that turns into a ghost server with people just reading through stuff and not interacting.\n\nSo this time the filter will be monetary, and that’s more than enough. At least I get something back.\n\nJoin here:\n<a href=\"https://discord.gg/D7CZMzw3rM\" target=\"_blank\" rel=\"noopener noreferrer\">discord.gg/D7CZMzw3rM</a>\n\nAll the instructions and details are inside the server.","postId":"Ugkx8m1MS7vwvc5mGwLEzGXk1vGfRX4ceZ5G","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1784129452135,"voteCount":7,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/tNKzupz8w9FHTZs2bmayymrOJGz6mr65tNNaN9hqsQSwUPyTsSg9Q1RZyNmNd4VRROm3DhetTsMe=s640-c-fcrop64=1,00000000ffffffff-nd-v1-rwa","width":640,"height":640}]},"commentCount":null,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"I&apos;ll see you on Sunday for the Livestream\n<a href=\"https://youtube.com/live/56F9nck3Vxs\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/live/56F9nck3Vxs</a>","postId":"Ugkx3X6mCMshGwMVc1g6v9hlNYUTaoWrJudN","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1781537452135,"voteCount":11,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/SwVzxD-FxxH2GJahZESuKMH7mKqOGaiI_0BKOtZ7PPiIOJpX4u_VvNXtoAB5gs5v-oG1pr73ppF6KA=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}]},"commentCount":2,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"We are doing a podcast exodus.\n\nI created a new channel just for the podcast:\n\n<a href=\"https://www.youtube.com/@linkarzu-podcast\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/@linkarzu-podcast</a>\n\nFrom now on, new edited podcast episodes will be uploaded over there instead of this main channel.\n\nThis main channel will keep being the place where I upload my regular content about Neovim, terminals, keyboards, Linux, workflows and whatever else I happen to be obsessed with that week.\n\nHonestly, if you subscribed mainly for the long interviews and you do not care about my regular or daily content, it is completely fine to unsubscribe from this channel and subscribe to the podcast channel instead. I would rather have the right people watching the right content than keep mixing everything together.\n\nOne important detail: the members-only podcast livestreams will still happen here on the main channel (this channel where you&apos;re reading the post). Anyone will still be able to join the live recording, interact in chat and watch the conversation before the edited episode is released publicly on the podcast channel.\n\nThe existing and already released podcast episodes will stay here, but new edited episodes are moving to their new home.\n\nSubscribe to the podcast channel here:\n<a href=\"https://www.youtube.com/@linkarzu-podcast\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/@linkarzu-podcast</a>","postId":"UgkxUILGF8pZdPwQta3xVOV410kJA3bcdv0p","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1781537452135,"voteCount":12,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/QgTAaOL5z-U_wWpqE_s1mHkIfMTHVED6lkJXUtIWTdKR7HsoA0lsuzfuW_Q4qbcd-9cEsPPU7oHI8f8=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}]},"commentCount":1,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"},{"postText":"I nuked discord, but never created a community after that. In case you are a reddit user I&apos;ll see you there!","postId":"Ugkx8u3SD4o2pSfiCCvfkk8mdAZuNcax4ua8","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/cDu9CNZUTDzIQsT6Y2VeYNm72cRa_hFaqOtY0tEZIIKECu26dXVAldJ8R7axCzD4smS553V5=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1781537452135,"voteCount":22,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/mk2pNViXyK5a4pCHC1_XegDzzLHL0DIbMigPeqFqwsaQYv_ijLDGcinWdHi_rJUF7tgljU2ka-GXfQ=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}]},"commentCount":null,"authorId":"UCrSIvbFncPSlK6AdwE2QboA","author":"linkarzu","type":"community"}],"communityPostsTimestamp":{"$$date":1791905452135}}
