{"_id":"UCwdm3PFpDuNtMaqAU6qxVBA","videos":[{"type":"video","videoId":"hIspjf9ybKQ","title":"How Great Developer Tools Get Built","author":"linkarzu-podcast","authorId":"UCwdm3PFpDuNtMaqAU6qxVBA","viewCount":196,"published":1786721474804,"lengthSeconds":5465,"liveNow":false,"isUpcoming":false,"isStation":false,"isPremiere":false},{"type":"video","videoId":"btAOBkcLEkg","title":"Learning Vanilla Emacs from Scratch with Prot as a Neovim User","author":"linkarzu-podcast and 2 more","authorId":"UCwdm3PFpDuNtMaqAU6qxVBA","viewCount":13000,"published":1784129474804,"lengthSeconds":6844,"liveNow":false,"isUpcoming":false,"isStation":false,"isPremiere":false},{"type":"video","videoId":"9ziLQK_kmKY","title":"Joshua Blais: Back Pain in Tech, Guix, Emacs, 34-Keys, Going Offline","author":"linkarzu-podcast and 2 more","authorId":"UCwdm3PFpDuNtMaqAU6qxVBA","viewCount":2400,"published":1781537474804,"lengthSeconds":7670,"liveNow":false,"isUpcoming":false,"isStation":false,"isPremiere":false}],"videosTimestamp":{"$$date":1791905474804},"liveStreams":[],"liveStreamsTimestamp":{"$$date":1791905445528},"shorts":[],"shortsTimestamp":{"$$date":1791905440377},"communityPosts":[{"postText":"I&apos;ll see you on Sunday for the Livestream\n<a href=\"https://youtube.com/live/56F9nck3Vxs\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/live/56F9nck3Vxs</a>","postId":"UgkxWx6gKtKj9B92dm_CksY-SYEEcm5O2A2A","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/rQ-6bLvg387RBM5K59hJ7WEo8V61sPUTQs528CvE9C3bJYS2ozEzk38SNQdIOfeegv32VFbARw=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/rQ-6bLvg387RBM5K59hJ7WEo8V61sPUTQs528CvE9C3bJYS2ozEzk38SNQdIOfeegv32VFbARw=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/rQ-6bLvg387RBM5K59hJ7WEo8V61sPUTQs528CvE9C3bJYS2ozEzk38SNQdIOfeegv32VFbARw=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1781537452055,"voteCount":1,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/XYL2g_mb59Cy8WlCeG418Y6WwxenKJhXAZElIUeKRuBgvghbFOCHYxCok0aST620r8UylFjBSwQwpg=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}]},"commentCount":null,"authorId":"UCwdm3PFpDuNtMaqAU6qxVBA","author":"linkarzu-podcast","type":"community"},{"postText":"Welcome to the new home of the linkarzu Podcast.\n\nIf you came over from my main channel, you made it through the podcast exodus. Thank you.\n\nThis is where I’ll publish new edited podcast episodes from now on: conversations about Neovim, terminals, keyboards, Linux, open source, workflows and the people building the tools we use.\n\nThe podcast used to live on my main linkarzu channel, so all the existing episodes will stay there in the original playlist:\n\n<a href=\"https://www.youtube.com/playlist?list=PLZWMav2s1MZRr93uiz6vjEWCdXL93QzGz\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/playlist?list=PLZWMav2s1MZRr93uiz6vjEWCdXL93QzGz</a>\n\nOne important detail: the podcast livestreams will still happen on my main channel, and anyone can join live, watch the conversation and participate in chat.\n\nAfter each livestream ends, the recording will become available to members on the main channel. The final edited episode will then be released publicly here on the podcast channel.\n\nOld episodes remain on the main channel. New edited podcast episodes start here.\n\nSubscribe so you don’t miss the next conversation.","postId":"UgkxizLZJEelAa0r0ADx6QpuhKv6ceTfGOwc","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/rQ-6bLvg387RBM5K59hJ7WEo8V61sPUTQs528CvE9C3bJYS2ozEzk38SNQdIOfeegv32VFbARw=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/rQ-6bLvg387RBM5K59hJ7WEo8V61sPUTQs528CvE9C3bJYS2ozEzk38SNQdIOfeegv32VFbARw=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/rQ-6bLvg387RBM5K59hJ7WEo8V61sPUTQs528CvE9C3bJYS2ozEzk38SNQdIOfeegv32VFbARw=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1781537452055,"voteCount":5,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/giq5l5QjVL6te3s9nS466NXc9q5eaWn5653_KSnkGNwRqtM5DZTQaDUY7TJkVGlEfRZ5REScB8mTnA=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}]},"commentCount":null,"authorId":"UCwdm3PFpDuNtMaqAU6qxVBA","author":"linkarzu-podcast","type":"community"}],"communityPostsTimestamp":{"$$date":1791905452055}}
