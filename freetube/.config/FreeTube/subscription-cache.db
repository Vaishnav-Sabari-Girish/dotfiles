ggpht.com/68VP-2xCS0SIYC5upi6LYzJtgP1g3Lu5jHSWj4npubSPPKIT4oTJDSp-TmiseqdUy4kZafIwWTnxWA=s640-c-fcrop64=1,013d0000fec2ffff-rw-nd-v1","width":640,"height":640}],[{"url":"https://yt3.ggpht.com/_pWPAOs-bQWHu5E-dji1sNzZDGADNPvXtubwn8YdSo7WE9csIhk6NYH_AXraH7aRIsa8HVTcSwAKqBw=s640-c-fcrop64=1,009f0000ff60ffff-rw-nd-v1","width":640,"height":640}]]},"commentCount":null,"authorId":"UCsLPJEAgH-KUJE2WobcLZ0A","author":"プラスウイングTV","type":"community"},{"postText":"画面出た！！","postId":"UgkxA1r5x6dt1bUTJ7kQHPQx8v0CaJnIefCD","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/ytc/AIdro_mgENCoJMtJ8gqyyPhBy7kBsICDVKwP4dB8Acqd6KLd1A=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_mgENCoJMtJ8gqyyPhBy7kBsICDVKwP4dB8Acqd6KLd1A=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_mgENCoJMtJ8gqyyPhBy7kBsICDVKwP4dB8Acqd6KLd1A=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1697234596050,"voteCount":13,"postContent":{"type":"multiImage","content":[[{"url":"https://yt3.ggpht.com/ASSViS95RoVmrgnvCXy8-HaqWaBR5YAh3PLyw--6_pDb43rgH6jpMfz2q7t4LIlSFgwefeQ_3vb-=s640-c-fcrop64=1,00000000ffffffff-rw-nd-v1","width":640,"height":640}],[{"url":"https://yt3.ggpht.com/W8TJ2bJsX0aK9KwuLmwtv6_sSXSqsrudPtJJRNVEsw33FZDH0SuemZc4g4VXQKYJ9pPSdn_IqAlFU8E=s640-c-fcrop64=1,00c20000ff3dffff-rw-nd-v1","width":640,"height":640}]]},"commentCount":null,"authorId":"UCsLPJEAgH-KUJE2WobcLZ0A","author":"プラスウイングTV","type":"community"},{"postText":"Docker超入門を投稿してから早2年弱。。\nその間、railsのバージョンが5から6になり、セットアップ手順が若干変わってしまいました。\nそのため動画の通りにやっても動かない。という事態に。\n（コメントいただき、さらには原因まで教えていただきました。ありがとうございますmm）\nDocker超入門 rails6対応ということで手順を記事にまとめました。動画と併せて参照ください。\n<a href=\"https://note.com/pluswing/n/n03944403f5c6\" target=\"_blank\" rel=\"noopener noreferrer\">note.com/pluswing/n/n03944403f5c6</a>","postId":"UgyRKx4c1tDbQO4pnoB4AaABCQ","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/ytc/AIdro_mgE