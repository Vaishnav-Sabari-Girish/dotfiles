g":false}],"videosTimestamp":{"$$date":1788444359980},"communityPosts":[{"postText":"Check out <a href=\"https://www.youtube.com/channel/UChG4-JbUgNQHlVdJGc2-pLA\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UChG4-JbUgNQHlVdJGc2-pLA</a>, the recordings from the event&apos;s talks are being published right now!\n\nZigtoberferst was a half-day event held in Munich, Germany. It was a lot of fun and if you leave in the general area be on the lookout for when the next one will run.\n\n<a href=\"https://zigtoberfest.de/\" target=\"_blank\" rel=\"noopener noreferrer\">zigtoberfest.de</a>","postId":"Ugkxbct943V9jzBFUwcnNvNNi39H9zoSYT73","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1754628211872,"voteCount":19,"postContent":null,"commentCount":null,"authorId":"UC2EQzAewrC10KCDFSS4j-zA","author":"Zig SHOWTIME","type":"community"},{"postText":"Thanks to this nice little tool I&apos;m now on all kinds of social media.\nVideo about this coming soon.\n\nTool:\n<a href=\"https://github.com/kristoff-it/simplex\" target=\"_blank\" rel=\"noopener noreferrer\">github.com/kristoff-it/simplex</a>\n\nYou can follow me here:\n<a href=\"https://twitter.com/croloris\" target=\"_blank\" rel=\"noopener noreferrer\">twitter.com/croloris</a>\n<a href=\"https://hachyderm.io/@kristoff\" target=\"_blank\" rel=\"noopener noreferrer\">hachyderm.io/@kristoff</a>\n<a href=\"https://bsky.app/profile/kristoff.bsky.social\" target=\"_blank\" rel=\"noopener noreferrer\">bsky.app/profile/kristoff.bsky.social</a>","postId":"UgkxaGwfoyGlUMRmIOz0MsMed9QdxwLO0YBP","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1691514307872,"voteCount":18,"postContent":null,"commentCount":1,"authorId":"UC2EQzAewrC10KCDFSS4j-zA","author":"Zig SHOWTIME","type":"community"},{"postText":"Live on Twitch to work on Autodoc, I&apos;m not going to spam the channel anymore with daily announcements, press the follow button on Twitch if you want to be notified when I go live (which is pretty much every day). <a href=\"https://twitch.tv/kristoff_it\" target=\"_blank\" rel=\"noopener noreferrer\">twitch.tv/kristoff_it</a>","postId":"Ugkx3ru-wpew01DJw2cypY291Fm8sx0jxRVH","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfFYPjWynV-1061Z4wZaK5z77G-mzfQ=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1691514307872,"voteCount":13,"postContent":null,"commentCount":null,"authorId":"UC2EQzAewrC10KCDFSS4j-zA","author":"Zig SHOWTIME","type":"community"},{"postText":"New day new autodoc stream. Come chat about Zig!\n\n<a href=\"https://twitch.tv/kristoff_it\" target=\"_blank\" rel=\"noopener noreferrer\">twitch.tv/kristoff_it</a>","postId":"Ugkx1TlGAqNNqhCopvZthvLyfnNGKhAz6FjA","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/ytc/AIdro_nMTmCdKMLRU5yEfF