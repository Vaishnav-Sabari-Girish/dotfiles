HYNc6frXpg","title":"von unten – \"2\", Amadeus Paulussen","author":"Amadeus Paulussen","authorId":"UCakcE5-vyVAn30dQ4LPmYtA","viewCount":30,"published":1571006810925,"lengthSeconds":181,"liveNow":false,"isUpcoming":false,"isStation":false,"isPremiere":false},{"type":"video","videoId":"1xqhyJAjji8","title":"untief – \"2\", Amadeus Paulussen","author":"Amadeus Paulussen","authorId":"UCakcE5-vyVAn30dQ4LPmYtA","viewCount":32,"published":1571006810925,"lengthSeconds":181,"liveNow":false,"isUpcoming":false,"isStation":false,"isPremiere":false},{"type":"video","videoId":"4imfApA8g-A","title":"noch ein Versuch – \"2\", Amadeus Paulussen","author":"Amadeus Paulussen","authorId":"UCakcE5-vyVAn30dQ4LPmYtA","viewCount":28,"published":1571006810925,"lengthSeconds":181,"liveNow":false,"isUpcoming":false,"isStation":false,"isPremiere":false}],"videosTimestamp":{"$$date":1791905474925},"liveStreams":[],"liveStreamsTimestamp":{"$$date":1791905445863},"shorts":[],"shortsTimestamp":{"$$date":1791905440407},"communityPosts":[{"postText":"Dear <a href=\"https://www.youtube.com/hashtag/linuxaudio\">#linuxaudio</a> friends,\nI would like to invite you to send me a short <a href=\"https://www.youtube.com/hashtag/sample\">#sample</a> or <a href=\"https://www.youtube.com/hashtag/recording\">#recording</a> that I can use to compose a little piece as a <a href=\"https://www.youtube.com/hashtag/challenge\">#challenge</a> for an upcoming Linux Audio Soliloquy <a href=\"https://www.youtube.com/hashtag/video\">#video</a>. 😊\n\nI created a drop folder on my Nextcloud for your uploads:\n<a href=\"https://nextcloud.paulussen.id/index.php/s/YNpCCG2jACaWY87\" target=\"_blank\" rel=\"noopener noreferrer\">nextcloud.paulussen.id/index.php/s/YNpCCG2jACaWY87</a>\n\nThank you in advance! 🤓","postId":"Ugkx4I5QzUq56ooWGMZi5PR7iiFA5gi3hbuc","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/ytc/AIdro_kiynhf5Z2YvKaEV7utvjJMynCT5DvgZtzvnW0VC-if1es=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76}