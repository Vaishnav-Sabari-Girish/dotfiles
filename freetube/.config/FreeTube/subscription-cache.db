fxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1762857163864,"voteCount":420,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/2QnBzHqbEnkvn5gRQ-K4brf6DJQ--UPKSQvpnoG6njHOYSnr7G5hC6hevstYrwh6ft6HCkSTZa5f=s453-c-fcrop64=1,000000006edeffff-rw-nd-v1","width":453,"height":453}]},"commentCount":44,"authorId":"UC65_CVnMw6hvPET_DRDg3GA","author":"tony","type":"community"},{"postText":"The Linux Cast hosted me on over on their weekly show here:\n\n<a href=\"https://www.youtube.com/watch?v=602Ap7w7R-g\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/watch?v=602Ap7w7R-g</a>\n\nWe covered one of the most relevant topics about linux: Window managers! Thanks Matt, Drew and Nate for hosting show. I&apos;ve been watching you guys for a long time, and it was really cool to sit down and discuss Linux together. \n\n\n<a href=\"https://www.youtube.com/channel/UCylGUf9BvQooEFjgdNudoQg\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UCylGUf9BvQooEFjgdNudoQg</a> <a href=\"https://www.youtube.com/channel/UC2rUTe_XMx88LR3JLJwyutw\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UC2rUTe_XMx88LR3JLJwyutw</a> <a href=\"https://www.youtube.com/channel/UC6l__ANw1LJyEL8BOzsQ-9Q\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UC6l__ANw1LJyEL8BOzsQ-9Q</a>","postId":"UgkxOnQe-eNp9d4Jav2F-4ddeNI7AFtF7te_","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1760265163864,"voteCount":21,"postContent":{"type":"video","content":{"type":"video","videoId":"602Ap7w7R-g","title":"Tools We Use For Our Linux Setups with @tony-btw","author":"The Linux Cast and tony","description":"The boys are back!  This week we talk about the tools you need to be good at Window Managers and Desktop Environments\n\n==== Special Thanks to Our Patrons! ====\nhttps://thelinuxcast.org/patrons/...","viewCount":11123,"published":1760265163864,"lengthSeconds":3888,"liveNow":false,"isUpcoming":false,"is4k":false,"is8k":false,"isNew":false,"isVr180":false,"isVr360":false,"is3d":false,"hasCaptions":false}},"commentCount":null,"authorId":"UC65_CVnMw6hvPET_DRDg3GA","author":"tony","type":"community"},{"postText":"Checkout my interview with <a href=\"https://www.youtube.com/channel/UCrSIvbFncPSlK6AdwE2QboA\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UCrSIvbFncPSlK6AdwE2QboA</a> on his channel here! We discussed a lot of the good stuff, including NixOS, Gentoo, Debian conspiracy theories, and much more!\n\n<a href=\"https://www.youtube.com/watch?v=lMkvCfJ_k_w\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/watch?v=lMkvCfJ_k_w</a>","postId":"Ugkx3WoehXmyPn7OJuxQJtT5mTFfNkpg-xyn","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/spaockfmw9-