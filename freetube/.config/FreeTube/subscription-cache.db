ykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1763393452078,"voteCount":425,"postContent":{"type":"image","content":[{"url":"https://yt3.ggpht.com/2QnBzHqbEnkvn5gRQ-K4brf6DJQ--UPKSQvpnoG6njHOYSnr7G5hC6hevstYrwh6ft6HCkSTZa5f=s453-c-fcrop64=1,000000006edeffff-rw-nd-v1","width":453,"height":453}]},"commentCount":44,"authorId":"UC65_CVnMw6hvPET_DRDg3GA","author":"tony","type":"community"},{"postText":"The Linux Cast hosted me on over on their weekly show here:\n\n<a href=\"https://www.youtube.com/watch?v=602Ap7w7R-g&pp=0gcJCR0AztywvtLA\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/watch?v=602Ap7w7R-g&pp=0gcJCR0AztywvtLA</a>\n\nWe covered one of the most relevant topics about linux: Window managers! Thanks Matt, Drew and Nate for hosting show. I&apos;ve been watching you guys for a long time, and it was really cool to sit down and discuss Linux together. \n\n\n<a href=\"https://www.youtube.com/channel/UCylGUf9BvQooEFjgdNudoQg\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UCylGUf9BvQooEFjgdNudoQg</a> <a href=\"https://www.youtube.com/channel/UC2rUTe_XMx88LR3JLJwyutw\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UC2rUTe_XMx88LR3JLJwyutw</a> <a href=\"https://www.youtube.com/channel/UC6l__ANw1LJyEL8BOzsQ-9Q\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UC6l__ANw1LJyEL8BOzsQ-9Q</a>","postId":"UgkxOnQe-eNp9d4Jav2F-4ddeNI7AFtF7te_","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1760348500078,"voteCount":21,"postContent":{"type":"video","content":{"type":"video","videoId":"602Ap7w7R-g","title":"Tools We Use For Our Linux Setups with @tony-btw","author":"The Linux Cast [Matthew Weber] and tony","description":"The boys are back!  This week we talk about the tools you need to be good at Window Managers and Desktop Environments\n\n==== Special Thanks to Our Patrons! ====\nhttps://thelinuxcast.org/patrons/...","viewCount":13831,"published":1760348500078,"lengthSeconds":3888,"liveNow":false,"isUpcoming":false,"isPremiere":false,"is4k":false,"is8k":false,"isNew":false,"isVr180":false,"isVr360":false,"is3d":false,"hasCaptions":false}},"commentCount":null,"authorId":"UC65_CVnMw6hvPET_DRDg3GA","author":"tony","type":"community"},{"postText":"Checkout my interview with <a href=\"https://www.youtube.com/channel/UCrSIvbFncPSlK6AdwE2QboA\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/channel/UCrSIvbFncPSlK6AdwE2QboA</a> on his channel here! We discussed a lot of the good stuff, including NixOS, Gentoo, Debian conspiracy theories, and much more!\n\n<a href=\"https://www.youtube.com/watch?v=lMkvCfJ_k_w\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/watch?v=lMkvCfJ_k_w</a>","postId":"Ugkx3WoehXmyPn7OJuxQJtT5mTFfNkpg-xyn","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1760348500078,"voteCount":28,"postContent":{"type":"video","content":{"type":"video","videoId":"lMkvCfJ_k_w","title":"Asking tony: Is NixOS Just Hype? (2077 Edition)","author":"linkarzu and tony","description":"There's a community of 8 users, that are very persistent, and always trying to get you to install NixOS. They swear by it and say it's the best thing ever happened after the discovery of fire...","viewCount":38639,"published":1760348500078,"lengthSeconds":6078,"liveNow":false,"isUpcoming":false,"isPremiere":false,"is4k":false,"is8k":false,"isNew":false,"isVr180":false,"isVr360":false,"is3d":false,"hasCaptions":false}},"commentCount":2,"authorId":"UC65_CVnMw6hvPET_DRDg3GA","author":"tony","type":"community"},{"postText":"What window manager/compositor do you use? (Comment if not listed)","postId":"Ugkx0Avk53YQPu1POMSRVkYCE1FLGNKRtEUV","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/spaockfmw9-_p4YCwjAJSV3BPHjykUofxUnSc1OlEitCBbk-0omPTRm017IF6tfMSE8RIqZO1Q=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1760348500078,"voteCount":48,"postContent":{"type":"poll","totalVotes":869,"content":[{"text":"dwm / dwl","image":null},{"text":"xmonad","image":null},{"text":"qtile","image":null},{"text":"hyprland","image":null}]},"commentCount":76,"authorId":"UC65_CVnMw6hvPET_DRDg3GA","author":"tony","type":"community"}],"communityPostsTimestamp":{"$$date":1791905452078},"shorts":[],"shortsTimestamp":{"$$date":1791905440329},"liveStreams":[],"liveStreamsTimestamp":{"$$date":1791905445520}}
