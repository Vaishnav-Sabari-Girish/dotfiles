ibnM4pD53vLMkttg=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/B97xDDfbIovs-J6z2qG8UilyHNq4ZpZFJ5V0eJWc8RsnEDqNeSa2YlQaeYtibnM4pD53vLMkttg=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1602563740099,"voteCount":11,"postContent":null,"commentCount":2,"authorId":"UCFNOT8x4KDYQQPUtmDsvaYA","author":"Alan Pope","type":"community"},{"postText":"Hey! I&apos;m going to be interviewed as a &quot;Special guest&quot; by Jason Evangelho from Forbes and Linux for Everyone. He&apos;s asked for some questions people can ask me. Feel free to jump on over to his community tab and ask away :D <a href=\"https://www.youtube.com/post/UgxzdhQRjsybL9-gecx4AaABCQ\" target=\"_blank\" rel=\"noopener noreferrer\">youtube.com/post/UgxzdhQRjsybL9-gecx4AaABCQ</a>","postId":"Ugyhy1kbwz6x4Dz7Btl4AaABCQ","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/B97xDDfbIovs-J6z2qG8UilyHNq4ZpZFJ5V0eJWc8RsnEDqNeSa2YlQaeYtibnM4pD53vLMkttg=s76-c-k-c0x00ffffff-no-rj-mo","width":76,"height":76},{"url":"https://yt3.googleusercontent.com/B97xDDfbIovs-J6z2qG8UilyHNq4ZpZFJ5V0eJWc8RsnEDqNeSa2YlQaeYtibnM4pD53vLMkttg=s48-c-k-c0x00ffffff-no-rj-mo","width":48,"height":48},{"url":"https://yt3.googleusercontent.com/B97xDDfbIovs-J6z2qG8UilyHNq4ZpZFJ5V0eJWc8RsnEDqNeSa2YlQaeYtibnM4pD53vLMkttg=s32-c-k-c0x00ffffff-no-rj-mo","width":32,"height":32}],"publishedTime":1602563740099,"voteCount":54,"postContent":null,"commentCount":3,"authorId":"UCFNOT8x4KDYQQPUtmDsvaYA","author":"Alan Pope","type":"community"},{"postText":"After the current round of testing flavours, I&apos;m looking for ideas for the next couple of videos.\n\nPeople in chat or comments as me to make snap related stuff. So I&apos;m looking for suggestions.\n\nShould I do a video where I..","postId":"UgxJymBp0EbLcTneGkN4AaABCQ","authorThumbnails":[{"url":"https://yt3.googleusercontent.com/B97xDDfbIovs-J6z2qG8UilyHNq4ZpZFJ5V0eJWc8RsnEDqNeSa2YlQaeYtibnM4pD53vLMkttg=s76-c-k-c0x00ffff